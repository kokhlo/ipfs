with "../ipfs.gpr";

project Examples is

   for Source_Dirs use (".");
   for Object_Dir use "obj";
   for Exec_Dir use "bin";
   for Main use ("fetch_cid.adb");

   package Compiler is
      for Default_Switches ("Ada") use
        ("-gnatwa", "-gnatwe", "-gnat2022");
   end Compiler;

   package Binder is
      for Default_Switches ("Ada") use ("-Es");
   end Binder;

end Examples;
